@inherits LayoutComponentBase

@inject IFlatFileUserStore UserStore;
@inject IConfigService Config;
@inject NavigationManager Navigation;

@if (_isReady)
{
    <CascadingValue Value="UserContext">
        @Body
    </CascadingValue>
}

@code {
    private bool _isReady;
    
    [CascadingParameter]
    protected Task<AuthenticationState>? AuthenticationState { get; set; }

    public UserContext UserContext { get; } = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState != null)
        {
            var state = await AuthenticationState;

            UserContext.User = await UserStore.FindByIdAsync(
                state.User.FindFirst(
                    x => x.Type == ClaimTypes.Sid
                )?.Value
            );
            
            UserContext.IsAuthenticated = state
                .User
                .Identity?
                .IsAuthenticated ?? false;
        }
        
        var relativePath = Navigation
            .ToBaseRelativePath(Navigation.Uri)
            .ToLowerInvariant();
        if (Config.Root!.Core.IsUnderMaintenance && !UserContext.IsAuthenticated)
        {
            var isAllowedInMaintenance = relativePath.StartsWith("admin")
                                         || relativePath.StartsWith("maintenance");

            if (!isAllowedInMaintenance)
            {
                Navigation.NavigateTo("/maintenance");
                return;
            }
        }
        
        if (relativePath.Trim('/') == "admin")
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }


    _isReady = true;
}

}